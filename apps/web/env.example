# =============================================================================
# UniPass Frontend Environment Configuration
# Copy this file to .env.local and fill in your values
# =============================================================================

# WalletConnect Project ID
# Get yours at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# =============================================================================
# Contract Addresses (update after deployment)
# =============================================================================

# UniPass Registry contract address
NEXT_PUBLIC_UNIPASS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Semaphore contract address (for reading group data)
NEXT_PUBLIC_SEMAPHORE_ADDRESS=0x0000000000000000000000000000000000000000

