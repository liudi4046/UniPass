# =============================================================================
# UniPass 前端配置 - Sepolia 测试网
# 复制此文件为 .env.local 并填入实际值
# =============================================================================

# WalletConnect Project ID (免费注册: https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# =============================================================================
# 合约地址（从部署输出获取）
# =============================================================================

# UniPass Registry 合约地址（部署后填入）
NEXT_PUBLIC_UNIPASS_REGISTRY_ADDRESS=0x部署后的地址

# Semaphore V4 官方地址（已确认，无需修改）
NEXT_PUBLIC_SEMAPHORE_ADDRESS=0x8A1fd199516489B0Fb7153EB5f075cDAC83c693D

